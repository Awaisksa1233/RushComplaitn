# ---- Database (Supabase / PostgreSQL) ----
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-1-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-1-[REGION].pooler.supabase.com:5432/postgres"

PORT=4000
NODE_ENV=production
# Behind a reverse proxy/CDN? Number of proxy hops, so rate limits key on the real client IP.
TRUST_PROXY=1

# ---- Secrets (REQUIRED; the server refuses to start without them) ----
# Generate each with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# 32 bytes (hex or base64) for AES-256-GCM encryption of IBAN / account holder. REQUIRED in production.
FIELD_ENCRYPTION_KEY=
# Shared secret used to verify HMAC-SHA256 signatures (x-hub-signature-256) on the WhatsApp webhook.
WHATSAPP_WEBHOOK_SECRET=

# ---- Web ----
# Comma-separated list of browser origins allowed cross-origin. Leave empty for same-origin only.
CORS_ORIGINS=
ALLOWED_SITES="RUSH Al Kharj"
PUBLIC_PORTAL_URL=https://crm.rush.com.sa/

# Development only: return the OTP in the API response. Only honoured when NODE_ENV=development.
EXPOSE_DEV_OTP=false

# ---- Company tax details shown to customers (SystemConfig VAT/CR override these) ----
RUSH_TAX_COMPANY="Rush Car Wash Operations Co."
RUSH_VAT_NUMBER=
RUSH_CR_NUMBER=
RUSH_TAX_ADDRESS=

# ---- Cloudflare R2 (objects are always served through the API proxy, never public) ----
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=rush-customer-care
R2_PUBLIC_URL=

# ---- POS MongoDB (read-only; OFF unless explicitly enabled) ----
MONGODB_URI=
ENABLE_LOCAL_MONGO=false

# ---- Unifonic SMS OTP ----
UNIFONIC_APP_ID=80bee0d0-9f5f-42eb-8225-5b80d6f5c0d7
UNIFONIC_SENDER_ID=RushWash
UNIFONIC_BASE_URL=https://el.cloud.unifonic.com

# ---- Chatwoot WhatsApp Integration ----
CHATWOOT_BASE_URL=https://chatwoot.rush.com.sa
CHATWOOT_API_TOKEN=
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_INBOX_ID=1

# ---- Data retention (days/hours) ----
RETENTION_OTP_HOURS=24
RETENTION_BANK_DAYS=90
RETENTION_TICKET_DAYS=730

# ---- Destructive scripts (prisma/seed*.ts) — both required, never set in production ----
# ALLOW_DESTRUCTIVE_SEED=yes
# CONFIRM_DB_HOST=<exact db host>
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=   # min 12 chars; if unset a random one is generated and printed once

# ---- Tests (admin suite is skipped without these) ----
# TEST_OWNER_EMAIL=
# TEST_OWNER_PASSWORD=
