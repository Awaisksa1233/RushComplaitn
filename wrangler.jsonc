{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rush-dashboard",
  "main": "src/worker.ts",
  "compatibility_date": "2024-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "ADMIN_USERNAME": "admin",
    "ADMIN_PASSWORD": "RushWash@2026",
    "ADMIN_SESSION_SECRET": "rushwash-cloudflare-worker-secret-2026",
    "VPS_API_URL": "https://whatsapp.rush.com.sa"
  },
  "build": {
    "command": "npm run build"
  }
}
